# ---- IDE / editor files ----
.vs/
.vscode/
.idea/
*.code-workspace
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Project files the engine regenerates ("Generate Visual Studio project files")
*.sln
*.xcodeproj
*.xcworkspace

# ---- Unreal generated folders (root project) ----
Binaries/*
Intermediate/*
Saved/*
DerivedDataCache/*

# ---- Unreal generated folders (inside plugins) ----
Plugins/**/Binaries/*
Plugins/**/Intermediate/*

# ---- Packaged builds ----
Build/*
# Keep PakBlacklist files and icons in Build
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Built lighting data (each person rebuilds locally)
*_BuiltData.uasset

# ---- Compiled C++ output ----
# Note: *.obj is intentionally NOT listed here. Compiler .obj files only
# appear inside Intermediate/ (already ignored), and a global *.obj rule
# would silently ignore Wavefront .obj 3D models.
*.slo
*.lo
*.o
*.gch
*.pch
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa
*.pdb